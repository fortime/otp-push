# Maintainer: fortime <palfortime@gmail.com>

_pkgbase=otp-push
pkgname=otp-push-server-git
_pkgver=0.2.0
pkgver=0.2.0
pkgrel=1
pkgdesc='A server and mobile app for pushing OTP from phone to client.'
url='https://github.com/fortime/otp-push'
source=("git+https://github.com/fortime/otp-push")
arch=('x86_64')
license=('MIT')
makedepends=('cargo' 'git' 'cmake')
options=(!lto)
depends=('bluez')
sha256sums=(SKIP)

pkgver() {
  cd "$srcdir/$_pkgbase"
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgbase"
  cargo fetch --target "$(rustc -vV | sed -n 's|host: ||p')"
}

build () {
  cmake \
      -D CMAKE_INSTALL_PREFIX=/usr \
      -B "${srcdir}/build-${_pkgver}" \
      -S "$srcdir/$_pkgbase"
  cmake --build "${srcdir}/build-${_pkgver}"
}

package() {
  DESTDIR="$pkgdir" cmake --install "${srcdir}/build-${_pkgver}"
}
